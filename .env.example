# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables (then redeploy).

# ── Booking calendar → GoHighLevel (optional until you're ready) ──────────────
# Leave all three unset and the /book calendar runs in "request mode": visitors
# pick a time and it opens a pre-filled email to the contact address in
# src/data/site.ts. Set all three and bookings land live on your GHL calendar.
GHL_API_KEY=            # Private Integration token
GHL_LOCATION_ID=        # your GHL sub-account (location) ID
GHL_CALENDAR_ID=        # the calendar bookings should land on

# ── Website chat assistant → Anthropic (optional until you're ready) ────────
# Leave unset and the chat bubble stays hidden. Set it (and redeploy) and a
# chat assistant appears on every page, answering from src/data/site.ts.
ANTHROPIC_API_KEY=      # from console.anthropic.com → API Keys
# ANTHROPIC_MODEL=claude-opus-5   # optional; e.g. claude-sonnet-5 or claude-haiku-4-5 to lower cost

# ── Site address (optional) ──────────────────────────────────────────────────
# Detected automatically on Vercel. Set only to force a specific domain.
# NEXT_PUBLIC_SITE_URL=https://www.example.com
